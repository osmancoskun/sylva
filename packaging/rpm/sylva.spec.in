# Generated by scripts/package.py. Edit this template, not dist/*/sylva.spec.
%global upstream_version @UPSTREAM_VERSION@
%global debug_package %{nil}

Name:           sylva
Version:        @RPM_VERSION@
Release:        1%{?dist}
Summary:        Encrypted password manager with self-hosted and Git storage
License:        GPL-3.0-only
URL:            https://github.com/osmancoskun/sylva
Source0:        https://github.com/osmancoskun/sylva/releases/download/v%{upstream_version}/%{name}-%{upstream_version}.tar.gz
Source1:        https://github.com/osmancoskun/sylva/releases/download/v%{upstream_version}/sylva.sysusers

BuildRequires:  golang >= 1.26.10
BuildRequires:  meson >= 1.3.0
BuildRequires:  ninja-build
BuildRequires:  python3
BuildRequires:  systemd-rpm-macros
BuildRequires:  git-core
ExclusiveArch:  x86_64 aarch64
Requires:       ca-certificates
Requires:       git-core
Requires:       openssh-clients
@BUNDLED_PROVIDES@

%description
Sylva encrypts secrets on the client and supports a self-hosted vault server
or a Git repository, persistent profiles, and optional SSH-agent unlock.

%package -n sylvad
Summary:        Sylva encrypted vault server
Requires:       ca-certificates
Requires(pre):  systemd-sysusers
%{?systemd_requires}
@BUNDLED_PROVIDES@

%description -n sylvad
The optional self-hosted Sylva server stores client-encrypted vault records
in SQLite. Includes a systemd service running as the dedicated sylva user.
It is not needed by clients using Git-backed vaults.

%prep
%autosetup -n %{name}-%{upstream_version}

%build
export GOTOOLCHAIN=local
export GOPROXY=off
export GOSUMDB=off
export GOWORK=off
export GOCACHE="$PWD/.gocache"
%meson -Drelease_version=%{upstream_version} -Doffline=true \
    -Dsystemd_unit_dir=%{_unitdir} -Dsysusers_dir=%{_sysusersdir}
%meson_build

%install
%meson_install

%check
%meson_test
test "$(%{_vpath_builddir}/sylva version)" = "sylva client v%{upstream_version}"
test "$(%{_vpath_builddir}/sylvad -version)" = "sylvad v%{upstream_version}"

%pre -n sylvad
%sysusers_create_package sylva %{SOURCE1}

%post -n sylvad
%systemd_post sylvad.service

%preun -n sylvad
%systemd_preun sylvad.service

%postun -n sylvad
%systemd_postun_with_restart sylvad.service

%files
%license %{_datadir}/licenses/sylva/
%doc %{_datadir}/doc/sylva/
%{_bindir}/sylva

%files -n sylvad
%license LICENSE THIRD_PARTY_LICENSES
%doc README.md docs/packaging.md docs/setup.md docs/mtls.md docs/tailscale.md
%{_bindir}/sylvad
%{_unitdir}/sylvad.service
%{_sysusersdir}/sylva.conf
%dir %attr(0750,root,sylva) %{_sysconfdir}/sylva
%config(noreplace) %attr(0640,root,sylva) %{_sysconfdir}/sylva/sylvad.conf
%config(noreplace) %attr(0600,root,root) %{_sysconfdir}/sysconfig/sylvad
%dir %attr(0700,sylva,sylva) %{_localstatedir}/lib/sylva

%changelog
@CHANGELOG@
