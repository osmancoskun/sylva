# Machine bind and secrets. Tunables live in internal/config/default.conf
# and optional overrides in .sylva/config (`sylva enable mtls|tailscale`).
# Host/port/authkey can move into .sylva/config later; process env still wins.

SYLVA_HOST=127.0.0.1
SYLVA_PORT=8443
SYLVA_TAILSCALE_AUTHKEY=
SYLVA_MASTER_PASSPHRASE=
