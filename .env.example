# Sylva centralized runtime configuration
# Copy this file to .env and adjust values for your environment.

# Service metadata
SYLVA_SERVICE_NAME=sylvad
SYLVA_VERSION=0.1.0-dev
SYLVA_LOG_LEVEL=info

# Network & server settings
SYLVA_HOST=127.0.0.1
SYLVA_PORT=8443
SYLVA_SCHEME=http

# Server HTTP timeouts
SYLVA_SERVER_READ_HEADER_TIMEOUT=5s
SYLVA_SERVER_READ_TIMEOUT=10s
SYLVA_SERVER_WRITE_TIMEOUT=10s
SYLVA_SERVER_IDLE_TIMEOUT=60s
SYLVA_SERVER_SHUTDOWN_TIMEOUT=5s

# Client HTTP settings
SYLVA_CLIENT_TIMEOUT=5s
SYLVA_CLIENT_MAX_RESPONSE_BYTES=1024

# Cryptography & Argon2id KDF parameters
SYLVA_KDF_TIME=3
SYLVA_KDF_MEMORY_KB=65536
SYLVA_KDF_THREADS=4
SYLVA_KDF_KEY_LEN=32
SYLVA_KDF_SALT_LEN=16
SYLVA_PASSWORD_DEFAULT_LEN=24

# Optional mTLS configuration
SYLVA_MTLS_ENABLED=false
SYLVA_CA_CERT_PATH=
SYLVA_SERVER_CERT_PATH=
SYLVA_SERVER_KEY_PATH=
SYLVA_CLIENT_CERT_PATH=
SYLVA_CLIENT_KEY_PATH=

# Optional Tailscale configuration
SYLVA_TAILSCALE_ENABLED=false
SYLVA_TAILSCALE_NODE=sylva

# Docker test & runtime images
SYLVA_DOCKER_GO_IMAGE=golang:1.26-alpine
SYLVA_DOCKER_RUNTIME_IMAGE=alpine:3.21
